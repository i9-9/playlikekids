# Sanity (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Write token for `npm run seed` only. Never expose this to the browser.
# Create at: Project → API → Tokens → Add API token (Editor)
SANITY_API_TOKEN=

# While under construction is on, visit /?preview=<this value> to see the real site.
# SITE_PREVIEW_SECRET=
