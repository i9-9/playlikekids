NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional: needed for write/seed scripts and draft previews
SANITY_API_TOKEN=

# Public site gate:
# - unset: under construction in production builds, full site in `next dev`
# - true: always under construction
# - false: always full site (use on Vercel when ready to launch)
# NEXT_PUBLIC_UNDER_CONSTRUCTION=false

# While the gate is on, visit /?preview=<this value> to see the real site.
# Visit /?preview=off to lock that browser again. Server-only — do not prefix NEXT_PUBLIC_.
# SITE_PREVIEW_SECRET=
